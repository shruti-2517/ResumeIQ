# ResumeIQ Configuration Template
# Copy this file to .env and replace required values.

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/resumeiq

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Drive (Optional for Drive Exports)
GOOGLE_DRIVE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-oauth-refresh-token

# Rate limiting and Application Settings
RATE_LIMIT_POST=10/hour
APP_VERSION=0.1.0
MAX_FILE_SIZE_MB=5
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=ResumeIQ
